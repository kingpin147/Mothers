# ─── DATABASE (Supabase PostgreSQL Connection Pooling) ─────────────
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# ─── APP & AUTHENTICATION (NextAuth.js v5) ──────────────────────────
NEXTAUTH_URL="https://themothers.cc"
NEXTAUTH_SECRET="your-32-byte-hex-random-secret"
NEXT_PUBLIC_APP_URL="https://themothers.cc"

# ─── PAYMENTS (Stripe) ─────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_live_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── COMMUNICATIONS (Brevo / Sendinblue) ───────────────────────────
BREVO_API_KEY="xkeysib-..."
BREVO_SENDER_NAME="The Mothers"
BREVO_SENDER_EMAIL="hello@themothers.cc"

# ─── CRON & BACKGROUND WORKERS (Vercel Cron Secret) ─────────────────
CRON_SECRET="your-secure-cron-bearer-token"
